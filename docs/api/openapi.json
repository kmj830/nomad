        "enum": ["WATERPROOF", "BACKPACK", "TRAVEL_BAG", "ACCESSORY", "LEATHER_CARE"]
      },
      "CheckInType": {
        "type": "string",
        "enum": ["BLE", "NFC", "QR", "MANUAL"]
      },
      "CheckInStatus": {
        "type": "string",
        "enum": ["COMPLETED", "PENDING", "EXPIRED"]
      },
