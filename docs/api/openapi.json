        "summary": "스마트 장바구니 상품 추가",
        "description": "추천 상품을 스마트 장바구니에 담습니다.",
        "operationId": "addToCart",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cart/choice-fit": {
      "put": {
        "tags": ["3. Cart API (스마트 장바구니 & ChoiceFit)"],
        "summary": "ChoiceFit (VIP 피팅 신청 여부) 상태 업데이트",
        "description": "장바구니 담기 후 피팅 신청 여부(true/false) 상태를 업데이트합니다.",
        "operationId": "updateChoiceFit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChoiceFitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cart/my": {
      "get": {
        "tags": ["3. Cart API (스마트 장바구니 & ChoiceFit)"],
        "summary": "내 스마트 장바구니 조회",
        "description": "현재 회원의 활성화된 스마트 장바구니 및 품목 목록을 조회합니다.",
        "operationId": "getMyCart",
        "parameters": [
          {
            "name": "memberId",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/store/check-in": {
      "post": {
        "tags": ["4. Store API (공항 면세점 체크인 & 태블릿 연동)"],
        "summary": "공항 면세점 체크인 처리",
        "description": "BLE/NFC 또는 수동 QR 체크인을 진행하고 매장 어시스턴트 태블릿 알림 및 웰컴 쿠폰을 전달합니다.",
        "operationId": "checkIn",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckInResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/store/re-entry-options/{memberId}": {
      "get": {
        "tags": ["4. Store API (공항 면세점 체크인 & 태블릿 연동)"],
        "summary": "매장 재방문(Re-entry Flow) 선택 분기 조회",
        "description": "구매 미완료 고객 재방문 시 바로 결제 / 다시 피팅 / 새 상품 보기 분기를 제공합니다.",
        "operationId": "getReEntryOptions",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReEntryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/store/notifications/stream": {
      "get": {
        "tags": ["4. Store API (공항 면세점 체크인 & 태블릿 연동)"],
        "summary": "SCR-402 매장 직원 태블릿 실시간 SSE 알림 스트림",
        "description": "고객이 면세점에 체크인할 때 매장 어시스턴트 태블릿으로 실시간 푸시 이벤트를 전송(Server-Sent Events)합니다.",
        "operationId": "subscribeStaffTablet",
        "responses": {
          "200": {
            "description": "실시간 SSE 이벤트 스트림",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/order/checkout": {
      "post": {
        "tags": ["5. Order API (면세 결제 & 마일리지)"],
        "summary": "면세점 주문 결제 및 마일리지 적립",
        "description": "장바구니 품목을 결제하고 VIP 티어별 면세 할인을 적용한 후 Herstory Miles를 적립합니다.",
        "operationId": "checkout",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "상태 불일치 (빈 장바구니 등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/care/visetos-spots": {
      "get": {
        "tags": ["6. Care API (현지 비세토스 스팟 & 케어)"],
        "summary": "현지 비세토스 스팟 탐색 및 가죽 케어 메시지 조회",
        "description": "목적지의 현지 MCM 플래그십 스토어 및 Care Desk 정보를 조회하고 맞춤형 케어 가이드를 반환합니다.",
        "operationId": "getVisetosSpots",
        "parameters": [
          {
            "name": "memberId",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CareResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/care/google-maps": {
      "get": {
        "tags": ["6. Care API (현지 비세토스 스팟 & 케어)"],
        "summary": "SCR-502 Google Maps API 실시간 MCM 매장 탐색",
        "description": "Google Maps API를 활용해 현지 MCM 부티크 위치 좌표 및 구글 지도 길안내 링크를 반환합니다.",
        "operationId": "getGoogleMapsSpots",
        "parameters": [
          {
            "name": "destination",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "Bangkok" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/VisetosSpot" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/care/ai-care-tip": {
      "get": {
        "tags": ["6. Care API (현지 비세토스 스팟 & 케어)"],
        "summary": "SCR-501 OpenAI 기반 가죽 케어 AI 가이드 생성 (다국어 지원: ko, en, ja, zh)",
        "description": "OpenAI GPT-4o를 활용해 구입 제품, 현지 기후 조건 및 다국어(ko, en, ja, zh) 맞춤형 가죽 관리 팁을 생성합니다.",
        "operationId": "getAiCareTip",
        "parameters": [
          {
            "name": "productName",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "MCM Visetos 백팩" }
          },
          {
            "name": "weather",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "습도 88% 열대성 스콜" }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "ko", "enum": ["ko", "en", "ja", "zh"] }
          }
        ],
        "responses": {
          "200": {
            "description": "성공 (텍스트 가이드)",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
