      "CartStatus": {
        "type": "string",
        "enum": ["IN_CART", "CHECKED_OUT", "CANCELLED"]
      },
      "OrderStatus": {
        "type": "string",
        "enum": ["PAID", "PENDING", "CANCELLED"]
      },
      "ProductCategory": {
