{
  "openapi": "3.0.3",
  "info": {
    "title": "Herstory AI - Backend REST API Specification",
    "description": "Herstory AI 백엔드 시스템 OpenAPI 3.0 명세서입니다.\n- Auth API: 로그인 & VIP 허브\n- Journey API: OCR 스캔, 기후 분석, Live Card 위젯, Apple Wallet .pkpass\n- Cart API: 스마트 장바구니 & ChoiceFit 피팅 신청\n- Store API: 면세점 체크인 & 매장 직원 태블릿 SSE 실시간 알림\n- Order API: 면세 결제 & Herstory Miles 적립\n- Care API: 현지 MCM 스팟, Google Maps, OpenAI 가죽 케어, 시티 스탬프, FCM\n- Flight API: 항공편 실시간 운항 정보 조회\n- Health API: 시스템 헬스 모니터링",
    "version": "v1.0.0",
    "contact": {
      "name": "Herstory Tech Team",
      "email": "tech@herstory.ai"
    }
  },
  "servers": [
    {
      "url": "https://mcm-nomad-backend.onrender.com",
      "description": "Render Production Server (Live)"
    },
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    { "name": "1. Auth API (인증)", "description": "Herstory 앱 로그인 및 VIP Herstory 허브 회원 접속 API" },
    { "name": "2. Journey API (여정 & 큐레이션)", "description": "보딩패스 Vision OCR PNR 스캔 및 목적지 날씨/기후 분석 큐레이션 API" },
    { "name": "3. Cart API (스마트 장바구니 & ChoiceFit)", "description": "스마트 장바구니 상품 담기 및 VIP 피팅 신청(ChoiceFit) 분기 설정 API" },
    { "name": "4. Store API (공항 면세점 체크인 & 태블릿 연동)", "description": "BLE/NFC/QR 체크인 및 매장 직원 어시스턴트 태블릿 알림 연동 API" },
    { "name": "5. Order API (면세 결제 & 마일리지)", "description": "선속 결제, VIP 티어별 면세 한도 할인 적용 및 Herstory Miles 마일리지 적립 API" },
    { "name": "6. Care API (현지 비세토스 스팟 & 케어)", "description": "목적지 현지 MCM 스팟 탐색 및 비세토스 가죽 케어 푸시 메시지 API" },
    { "name": "7. Flight API (실시간 항공편 & 운항 정보)", "description": "편명(IATA Code) 기준 실시간 항공편 운항 상태, 터미널, 탑승구(Gate) 조회 API" },
    { "name": "8. System Health API (서버 및 외부 API 모니터링)", "description": "Render PostgreSQL DB, OpenAI GPT-4o, Google Maps, Flight API 실시간 상태 모니터링 API" }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": ["1. Auth API (인증)"],
        "summary": "신규 회원가입",
        "description": "이메일, 비밀번호, 이름, 연락처를 통해 신규 회원을 등록하고 웰컴 마일리지를 지급합니다.",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "가입 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청 또는 이메일 중복",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["1. Auth API (인증)"],
        "summary": "앱 로그인",
        "description": "이메일과 비밀번호를 통해 로그인하며 VIP 티어 및 Herstory 마일리지를 반환합니다.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청 또는 인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/journey/scan": {
      "post": {
        "tags": ["2. Journey API (여정 & 큐레이션)"],
        "summary": "보딩패스 OCR 스캔 & 여정 등록",
        "description": "탑승권 OCR 스캔을 통해 PNR을 추출하고 비행 여정을 저장합니다.",
        "operationId": "scanBoardingPass",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/journey/analysis/{journeyId}": {
      "get": {
        "tags": ["2. Journey API (여정 & 큐레이션)"],
        "summary": "목적지 기후 및 여행 분석 데이터 조회",
        "description": "목적지 날씨 및 기후 정보를 분석하여 맞춤형 MCM 상품을 추천합니다.",
        "operationId": "analyzeJourney",
        "parameters": [
          {
            "name": "journeyId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JourneyAnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/journey/live-card/{journeyId}": {
      "get": {
        "tags": ["2. Journey API (여정 & 큐레이션)"],
        "summary": "SCR-102 AI 라이브 카드 위젯 정보 조회",
        "description": "실시간 항공편 탑승 카운트다운, 게이트 번호, 공항 라운지 현황 및 안내 메시지를 조회합니다.",
        "operationId": "getLiveCard",
        "parameters": [
          {
            "name": "journeyId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveCardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/journey/apple-wallet-pass/{journeyId}": {
      "get": {
        "tags": ["2. Journey API (여정 & 큐레이션)"],
        "summary": "SCR-201 Apple Wallet 디지털 패스(.pkpass) 메타데이터 생성",
        "description": "비행 탑승권 및 VIP 여정 보딩패스를 Apple Wallet PKPass 형태로 생성합니다.",
        "operationId": "getAppleWalletPass",
        "parameters": [
          {
            "name": "journeyId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppleWalletPassResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/journey/apple-wallet-pass/download/{journeyId}": {
      "get": {
        "tags": ["2. Journey API (여정 & 큐레이션)"],
        "summary": "Apple Wallet (.pkpass) 바이너리 파일 다운로드",
        "description": "iOS 아이폰 디바이스 지갑(Wallet) 앱에 직접 추가할 수 있는 .pkpass 패스 파일을 다운로드합니다.",
        "operationId": "downloadAppleWalletPass",
        "parameters": [
          {
            "name": "journeyId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공 (바이너리 .pkpass 스트림)",
            "content": {
              "application/vnd.apple.pkpass": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/journey/apple-wallet-pass/download-file/{journeyId}": {
      "get": {
        "tags": ["2. Journey API (여정 & 큐레이션)"],
        "summary": "아이폰 범용 패스 파일 다운로드 (Safari 다운로드 호환)",
        "description": "iOS Safari 보안 차단 없이 아이폰 파일 앱(Downloads)으로 직접 다운로드할 수 있는 패스 파일 API입니다.",
        "operationId": "downloadAppleWalletPassFile",
        "parameters": [
          {
            "name": "journeyId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공 (바이너리 스트림)",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
